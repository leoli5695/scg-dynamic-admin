# gateway-ui environment template
#
# Copy to .env.local (or export as real environment variables) to override.
# Both values are optional - the defaults below are what vite.config.ts falls
# back to, and they are recorded here because they were previously only
# discoverable by reading the config.

# Base URL the built bundle uses for API calls. Leave unset to use same-origin
# relative paths, which is what the nginx image in gateway-ui/Dockerfile expects
# (it proxies /api to the backend).
VITE_API_BASE_URL=

# Target of the dev-server and `vite preview` proxies for /api. Point this at
# wherever gateway-admin listens; application.yml defaults to port 9090 while
# docker-compose pins it to 8080.
VITE_ADMIN_API_TARGET=http://localhost:9090
