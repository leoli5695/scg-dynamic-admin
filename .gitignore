# OS
.DS_Store
Thumbs.db

# Debug screenshots (smoke test artifacts)
*.png

# Environment files with real credentials - never commit
# (.env.example templates are tracked; actual .env files are not)
.env
**/.env
!**/.env.example

# Application specific
gateway-admin/admin-err.log
gateway-admin/admin.log
gateway-admin/run.log
gateway-admin/admin-startup.log
gateway-admin/admin-new.log
gateway-admin/admin-err-new.log
*.tar
*.tar.gz

# Binary files - should never be committed
*.zip
*.jar
nul
arthas-*
arthas-boot.jar
arthas-bin.zip
demo-*.tar

# Frontend build artifacts - generated at build time, not version controlled
gateway-admin/src/main/resources/static/assets/

# Submodules (use git submodule, not directory)
nacos/
