# ============================================================================
# Gateway Admin - Environment Variables Template
# ============================================================================
# Copy this file to .env.development or .env.production and fill in the values.
# NEVER commit actual .env files to version control!
# ============================================================================

# ----------------------------------------------------------------------------
# Database Configuration (MySQL)
# ----------------------------------------------------------------------------
# Required: Database connection settings
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USERNAME=your_db_username
MYSQL_PASSWORD=your_secure_password_here

# Optional: SSL configuration (recommended for production)
MYSQL_USE_SSL=true
MYSQL_REQUIRE_SSL=true
MYSQL_ALLOW_PUBLIC_KEY_RETRIEVAL=false

# ----------------------------------------------------------------------------
# Redis Configuration
# ----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here

# ----------------------------------------------------------------------------
# Nacos Configuration
# ----------------------------------------------------------------------------
NACOS_SERVER_ADDR=localhost:8848
NACOS_NAMESPACE=public

# Service Discovery (set to true in production with proper Nacos setup)
NACOS_DISCOVERY_ENABLED=false
NACOS_DISCOVERY_IP=127.0.0.1

# ----------------------------------------------------------------------------
# JWT Security Configuration
# ----------------------------------------------------------------------------
# CRITICAL: Must be at least 32 characters for HS256
# Recommended: 64 characters for enhanced security
# Generate with: openssl rand -base64 64
GATEWAY_ADMIN_JWT_SECRET=CHANGE_ME_TO_A_SECURE_RANDOM_STRING_MIN_32_CHARS

# ----------------------------------------------------------------------------
# SSL Certificate Encryption Key
# ----------------------------------------------------------------------------
# Minimum: 16 bytes (128 bits), Recommended: 32 bytes for AES-256
GATEWAY_ADMIN_SSL_ENCRYPTION_KEY=CHANGE_ME_TO_16_CHAR_KEY

# ----------------------------------------------------------------------------
# Kubernetes Configuration
# ----------------------------------------------------------------------------
K8S_ENABLED=true

# ----------------------------------------------------------------------------
# Middleware Monitoring
# ----------------------------------------------------------------------------
ROCKETMQ_CONSOLE_URL=http://localhost:8080

# ----------------------------------------------------------------------------
# Gateway Admin URLs
# ----------------------------------------------------------------------------
GATEWAY_ADMIN_URL=http://localhost:9090
GATEWAY_ADMIN_K8S_URL=http://host.rancher-desktop.internal:9090

# ----------------------------------------------------------------------------
# Consul Configuration (if using Consul instead of Nacos)
# ----------------------------------------------------------------------------
CONSUL_HOST=localhost
CONSUL_PORT=8500

# ----------------------------------------------------------------------------
# Jaeger Tracing Configuration
# ----------------------------------------------------------------------------
JAEGER_ENDPOINT=http://localhost:14268/api/traces

# ----------------------------------------------------------------------------
# License Configuration (offline RSA validation - no license-server required)
# ----------------------------------------------------------------------------
# license-client never dials a server: with no GATEWAY_LICENSE_CODE it builds a
# fallback license locally, so LICENSE_FALLBACK_EDITION alone decides which of the
# 35 gated features are enabled. Defaults to ENTERPRISE (all features, unlimited
# quotas); set BASIC to restrict. LICENSE_ENABLED=false only skips the per-request
# check - it does NOT unlock features, because LicenseFeatureHelper consults the
# gatekeeper unconditionally.
LICENSE_FALLBACK_EDITION=ENTERPRISE
LICENSE_ENABLED=false
# Only needed when you actually deploy license-server and mint a signed license.
# The public key must be pinned: a license carries its own, so without pinning
# anyone can self-sign one.
#GATEWAY_LICENSE_CODE=
#LICENSE_TRUSTED_PUBLIC_KEYS=
