# =============================================================================
# Gateway Admin - environment template for docker-compose
#
#   cp .env.example .env    # then replace EVERY placeholder below
#
# docker-compose.yml marks each of these with `${VAR:?...}`, so compose aborts
# with a named error instead of starting with a weak default. Nothing here has a
# usable fallback on purpose.
#
# This file is for the compose stack. gateway-admin/.env.example is the larger
# template for running the jar directly (local development).
# =============================================================================

# --- MySQL (REQUIRED) ---------------------------------------------------------
# Root password; only used by the container healthcheck and initial provisioning.
# Generate with: openssl rand -base64 32
MYSQL_ROOT_PASSWORD=change_me_openssl_rand_base64_32

# Application account. MYSQL_USERNAME is what gateway-admin connects as
# (application.yml reads ${MYSQL_USERNAME} with no default).
MYSQL_USERNAME=gateway_user
MYSQL_PASSWORD=change_me_openssl_rand_base64_32

# --- Initial console administrator (REQUIRED) ---------------------------------
# AuthService creates the first admin ONLY when both are set; otherwise it logs a
# warning and returns, leaving the console with no user and no way to register one.
# ADMIN_PASSWORD must be at least 12 characters or creation is skipped.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_at_least_12_characters

# --- Gateway Admin secrets (REQUIRED) -----------------------------------------
# JWT signing secret. Generate with: openssl rand -base64 64
GATEWAY_ADMIN_JWT_SECRET=change_me_openssl_rand_base64_64

# AES-256-GCM key for AI provider API keys and SSL keystore passwords.
# Minimum 16 characters. Generate with: openssl rand -base64 32
GATEWAY_ENCRYPTION_KEY=change_me_openssl_rand_base64_32

# Shared secret guarding the internal report endpoints (heartbeat / trace upload /
# health sync) via the X-Internal-Token header. Startup fails when empty.
# Must be IDENTICAL on gateway-admin and on every gateway instance.
# Generate with: openssl rand -base64 32
GATEWAY_INTERNAL_TOKEN=change_me_openssl_rand_base64_32
