# Gateway Admin Environment Variables
# Copy this file to .env and update the values

# Database Password (REQUIRED)
# Generate a strong password for production
DB_PASSWORD=your_secure_db_password_here

# JWT Secret (REQUIRED)
# Generate with: openssl rand -base64 64
# Or use any secure random string generator
GATEWAY_ADMIN_JWT_SECRET=your_jwt_secret_here_generate_with_openssl_rand_base64_64

# Encryption Key (REQUIRED, minimum 16 characters)
# Used for encrypting AI provider API keys and SSL keystore passwords (AES-256-GCM)
# Generate with: openssl rand -base64 32
GATEWAY_ENCRYPTION_KEY=your_encryption_key_here_generate_with_openssl_rand_base64_32

# Internal API Token (REQUIRED - startup fails when empty)
# Shared secret protecting gateway instance internal report endpoints
# (heartbeat / trace upload / health sync) via the X-Internal-Token header.
# Must be identical on gateway-admin and all gateway instances.
# Generate with: openssl rand -base64 32
GATEWAY_INTERNAL_TOKEN=your_internal_token_here_generate_with_openssl_rand_base64_32
